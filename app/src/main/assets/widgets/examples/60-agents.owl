widget "agents" {
  page: 2
  order: 2
  size: 3x5
  minSize: 3x3

  // Every agent the launcher installs, in its order; omp needs --allow-home to stay in ~ (see Agents.kt).
  source installed = cmd("for a in claude opencode codex grok copilot crush cursor-agent agy pi omp hermes; do command -v $a >/dev/null && printf '%s ' $a; done") every 5m

  Column {
    gap: 6
    Text { text: "coding agents"; style: muted }
    if len(words(installed)) == 0 {
      Text { text: "none installed yet"; style: small }
    }
    Flow {
      gap: 6
      for agent in words(installed) {
        Button { text: agent; onTap: terminal(agent == "omp" ? "omp --allow-home" : agent) }
      }
    }
    Button { text: "manage"; color: muted; onTap: launcher("agents") }
  }
}
